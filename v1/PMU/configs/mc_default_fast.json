{
  "experiment": {
    "fs_physics_hz": 100000,
    "fs_dsp_hz": 10000,
    "seed": 42,

    "methods": [
      "RA-EKF",
      "IpDFT"
    ],

    "enable_landscapes": false,
    "enable_per_scenario_plots": false,
    "enable_global_summaries": true,

    "mc": {
      "n_train_seeds": 1,
      "n_test_seeds": 1, 
      "base_seed": 123,
      "tune_frac": 0.5,
      "report_percentiles": [50, 95],
      "tune_on_train_segment_only": true,
      "evaluate_on_test_segment_only": true,

      "perturb": {
        "amp_pct_jitter": 0.01,
        "snr_db_jitter": 1.0,
        "impulsive_prob": 0.001,
        "impulsive_scale": 2.0
      }
    }
  },

  "tuners": {
    "ra-ekf": {
      "q_param": [1e-6, 1e-4],
      "r_param": [1e-2, 0.1]
    },
    "ipdft": {
      "window_cycles": [4, 8],
      "decim": [1]
    },
    "teager": {
      "win_smooth": [10, 50]
    }
  }
}